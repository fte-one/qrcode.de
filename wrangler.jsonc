{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrcode-de",
  "compatibility_date": "2026-11-01",
  "account_id": "f3e6984dcc97a64e3d564710e231216e",
  // Statische Seite aus dem Next-Export; der Worker leitet nur www.qrcode.de auf qrcode.de um
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "qrcode.de", "custom_domain": true },
    { "pattern": "www.qrcode.de", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
